# Environment Configuration
ENV=development

# Model Paths
MODELS_DIR=./models
WORKOUT_MODEL_PATH=./models/workout_model.pkl
FOOD_MODEL_PATH=./models/food_recognition_model.h5

# API Configuration
API_V1_PREFIX=/api/v1
MAX_UPLOAD_SIZE=10485760

# ML Settings
DEVICE=cpu
BATCH_SIZE=32
IMAGE_SIZE=224

# Food Recognition
FOOD_CLASSES=101
CONFIDENCE_THRESHOLD=0.7

# Workout Generation
MIN_EXERCISES=4
MAX_EXERCISES=12
DEFAULT_WORKOUT_DURATION=45

# Backend API
BACKEND_API_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
